msgid "Search a title, a city or a name…"
msgstr "ابحث عن عنوان أو مدينة أو اسم…"

msgid "Select"
msgstr "تحديد"

msgid "Select all"
msgstr "تحديد الكل"

msgid "Select at least one announcement."
msgstr "حدِّد إعلانًا واحدًا على الأقل."

msgid "Shown on the announcement page. Empty fields fall back to the mosque contact details."
msgstr "تظهر في صفحة الإعلان. تعود الحقول الفارغة إلى بيانات الاتصال بالمسجد."

msgid "Sign in"
msgstr "تسجيل الدخول"

msgid "Sign out"
msgstr "تسجيل الخروج"

msgid "Staff access"
msgstr "دخول الفريق"

msgid "The announcements changed most recently."
msgstr "الإعلانات التي عُدّلت مؤخرًا."

msgid "The email or password is incorrect. Please try again."
msgstr "البريد الإلكتروني أو كلمة المرور غير صحيحة. يرجى المحاولة مرة أخرى."

msgid "This account is disabled."
msgstr "هذا الحساب معطَّل."

msgid "This action is permanent and removes the announcement from the public site."
msgstr "هذا الإجراء نهائي ويزيل الإعلان من الموقع العام."

msgid "This area is reserved for the mosque team."
msgstr "هذه المنطقة مخصصة لفريق المسجد."

msgid "Totals by currency."
msgstr "الإجماليات حسب العملة."

msgid "Trust and discretion, at the service of the community."
msgstr "ثقة وتكتّم في خدمة المجتمع."

msgid "Try different keywords or filters, or create a new announcement."
msgstr "جرّب كلمات مفتاحية أو عوامل تصفية أخرى، أو أنشئ إعلانًا جديدًا."

msgid "Uncheck to keep this announcement as a draft."
msgstr "أزل التحديد لإبقاء هذا الإعلان كمسودة."

msgid "Unknown action."
msgstr "إجراء غير معروف."

msgid "Update the progress of each fundraiser"
msgstr "تحديث تقدم كل حملة تبرع"

msgid "Update this amount to keep the progress bar accurate."
msgstr "حدِّث هذا المبلغ للحفاظ على دقة شريط التقدم."

msgid "View all"
msgstr "عرض الكل"

msgid "View on the public site"
msgstr "عرض على الموقع العام"

msgid "View the dashboard in Arabic"
msgstr "عرض لوحة التحكم بالعربية"

msgid "View the dashboard in English"
msgstr "عرض لوحة التحكم بالإنجليزية"

msgid "Visibility"
msgstr "الظهور"

msgid "Welcome back."
msgstr "مرحبًا بعودتك."

msgid "Who the announcements are for."
msgstr "لمن الإعلانات."

msgid "Who the help is for, and where."
msgstr "لمن المساعدة، وأين."

msgid "Write the announcement in Arabic, English, or both."
msgstr "اكتب الإعلان بالعربية أو الإنجليزية أو كليهما."

msgid "You have been signed out."
msgstr "تم تسجيل خروجك."

msgid "Your login is created by the mosque administrator."
msgstr "ينشئ مدير المسجد بيانات دخولك."

msgid "Your password has been changed."
msgstr "تم تغيير كلمة المرور."

msgid "This announcement no longer exists."
msgstr "لم يعد هذا الإعلان موجودًا."
