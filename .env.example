# ---------------------------------------------------------------------------
# Local development configuration — copy to .env and adjust.
# On Render, these values come from the dashboard instead.
# ---------------------------------------------------------------------------

DEBUG=True
SECRET_KEY=dev-only-secret-key-change-me
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# SQLite is used when DATABASE_URL is empty.
# Local MySQL via docker compose (see docker-compose.yml):
# DATABASE_URL=mysql://qubaa:qubaa@127.0.0.1:3307/qubaa?charset=utf8mb4
# Production MySQL:
# DATABASE_URL=mysql://user:password@host:3306/qubaa?charset=utf8mb4
# DB_SSL_CA=/path/to/provider-ca.pem
# DB_SSL_VERIFY=True

SITE_NAME_AR=مسجد قباء
SITE_NAME_EN=Qubaa Mosque
SITE_TAGLINE_AR=نخدم مجتمعنا
SITE_TAGLINE_EN=Serving our community

CONTACT_EMAIL=contact@example.org
CONTACT_PHONE=+212 600 000 000
CONTACT_ADDRESS_AR=حي النور، الرباط، المغرب
CONTACT_ADDRESS_EN=Hay Ennour, Rabat, Morocco

DEFAULT_CURRENCY=EUR

# Used by: python manage.py ensure_admin
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=ChangeMe-12345!
ADMIN_NAME=Administrator
# Set to True for one deploy to reset the password from ADMIN_PASSWORD.
# ADMIN_RESET_PASSWORD=False

# Enable once the site is served over HTTPS.
# SECURE_SSL_REDIRECT=False
# SECURE_HSTS_SECONDS=0
